OPENAI_API_KEY=""

# Server settings
HOST=127.0.0.1
PORT=8765
LOG_LEVEL=INFO

# WebSocket settings
PING_INTERVAL=30
PING_TIMEOUT=10
HEARTBEAT_INTERVAL=60
# 1MB = 1048576
MAX_MESSAGE_SIZE=1048576
MAX_QUEUE_SIZE=32

# Rate limiting
RATE_LIMIT_MAX_MESSAGES=10
RATE_LIMIT_WINDOW_SECONDS=1.0

# Authentication (using a simple key for development, use RSA for production)
JWT_PUBLIC_KEY='{"1": "./public.pem"}'
JWT_ISSUER="test-issuer"
JWT_AUDIENCE="test-audience"
REQUIRED_SCOPE="api:access"

# RabbitMQ settings
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_CONNECTION_TIMEOUT=5
RABBITMQ_CONNECTION_POOL_SIZE=2
RABBITMQ_CHANNEL_POOL_SIZE=10
RABBITMQ_PREFETCH_COUNT=10
MAX_REDELIVERY_COUNT=3

# Queue settings
AUTOMATION_EXCHANGE=automation
AUTOMATION_JOBS_QUEUE=automation_jobs
AUTOMATION_RESULTS_QUEUE=automation_results
DEAD_LETTER_EXCHANGE=dead_letter
DEAD_LETTER_QUEUE=dead_letter_queue
QUEUE_MESSAGE_TTL=86400000
# 86400000 = 24 hours in milliseconds

# Metrics
METRICS_HOST=0.0.0.0
METRICS_PORT=8000

# OpenTelemetry (optional)
ENABLE_TRACING=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
# OTEL_SERVICE_NAME=websocket_server
