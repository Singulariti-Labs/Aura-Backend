OPENAI_API_KEY="YOUR OPENAI API KEY"
ANTHROPIC_API_KEY="YOUR ANTHROPIC API KEY"
OPENROUTER_API_KEY="YOUR OPEN ROUTER API KEY"
GOOGLE_API_KEY="YOUR GOOGLE API KEY"
DEEPGRAM_API_KEY="YOUR DEEPGRAM API KEY"
MORPH_API_KEY="MORPH API KEY"
SCREEN_PARSING_URL="SCREEN PARSER MODEL URL FOR COMPUTER USE"
TAVILY_API_KEY="TAVILY SEARCH API KEY FOR WEB SEARCH"
DATABASE_URL="DATABASE URL"
AUTH0_DOMAIN="AUTH0 DOMAIN FOR AUTHENTICATION"
AUTH0_API_AUDIENCE="AUTH0 API AUDIENCE URL FOR AUTHENTICATION"

# Promo access is the default launch mode. Use a random 32+ character secret.
BILLING_MODE="promo"
PROMO_CODE_PEPPER="GENERATE-A-LONG-RANDOM-SECRET-OF-AT-LEAST-32-CHARACTERS"

# Future Stripe subscriptions. Set BILLING_MODE="stripe" only when ready.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRODUCT_MINI="prod_..."
STRIPE_PRICE_MINI_MONTHLY="price_..."
STRIPE_PRODUCT_PRO="prod_..."
STRIPE_PRICE_PRO_MONTHLY="price_..."
STRIPE_PRODUCT_MAX="prod_..."
STRIPE_PRICE_MAX_MONTHLY="price_..."
BILLING_SUCCESS_URL="https://app.example.com/settings/billing/success"
BILLING_CANCEL_URL="https://app.example.com/settings/billing"
BILLING_PORTAL_RETURN_URL="https://app.example.com/settings/billing"

# Single-process task coordination. Use one Uvicorn worker while backend=memory.
TASK_COORDINATOR_BACKEND="memory"
MAX_RUNNING_TASKS_PER_USER=4
MAX_RUNNING_TASKS_PER_INSTANCE=50
MAX_QUEUED_TASKS_PER_INSTANCE=500

# Pending client-tool response lifecycle.
CLIENT_TOOL_TIMEOUT_SECONDS=120
CLIENT_FILE_TOOL_TIMEOUT_SECONDS=300
CLIENT_USER_TOOL_TIMEOUT_SECONDS=900
EXPIRED_TOOL_CALL_TTL_SECONDS=900

# Graph-memory consolidation. The endpoint has a fixed 30-second timeout.
# MEMORY_LLM_API_KEY is optional; the standard provider key is used when empty.
MEMORY_LLM_PROVIDER="anthropic"
MEMORY_LLM_MODEL="claude-haiku-4-5-20251001"
MEMORY_LLM_API_KEY=""
MEMORY_MAX_BODY_BYTES=1048576

# Realtime speech-to-text limits.
STT_MAX_ACTIVE_SESSIONS=200
STT_MAX_SESSIONS_PER_USER=2
STT_AUDIO_QUEUE_SIZE=50
STT_MAX_SESSION_SECONDS=600
STT_POLISH_ENABLED=true
STT_POLISH_PROVIDER="openai"
STT_POLISH_MODEL="gpt-4o-mini"
STT_CLIENT_FINAL_CLOSE_DELAY_SECONDS=10
